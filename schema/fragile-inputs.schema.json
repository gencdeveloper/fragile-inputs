{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gencdeveloper/fragile-inputs/schema/fragile-inputs.schema.json",
  "title": "Fragile Inputs dataset",
  "type": "object",
  "required": ["name", "version", "groups", "categories", "inputs"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "homepage": {"type": "string"},
    "license": {"type": "string"},
    "funding": {"type": "string"},
    "updated": {"type": "string"},
    "counts": {"type": "object"},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "group", "name"],
        "properties": {
          "id": {"type": "string"},
          "group": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "warning": {"type": "string"}
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "group", "category", "title", "value", "tests", "breaks", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^fi-[0-9]{3,}$"},
          "group": {"type": "string"},
          "category": {"type": "string"},
          "title": {"type": "string"},
          "value": {"type": "string", "description": "The input to paste. May contain invisible characters."},
          "tests": {"type": "string", "description": "What this input exercises."},
          "breaks": {"type": "string", "description": "What goes wrong when it is mishandled."},
          "expected": {"type": "string", "description": "Correct behavior."},
          "wcag": {"type": "string", "description": "Related WCAG 2.2 success criterion, for accessibility inputs."},
          "hasInvisible": {"type": "boolean", "description": "Value contains characters that do not render visibly."},
          "spacesVisible": {"type": "boolean"},
          "dynamic": {
            "type": "object",
            "description": "Rule to recompute a date-relative value for the current day.",
            "properties": {
              "kind": {"enum": ["offset-date", "card-expiry"]},
              "years": {"type": "integer"},
              "months": {"type": "integer"},
              "days": {"type": "integer"},
              "monthOffset": {"type": "integer"},
              "format": {"type": "string"}
            }
          },
          "valueIsSnapshot": {"type": "boolean", "description": "value is a snapshot; use `dynamic` to recompute."}
        }
      }
    }
  }
}
